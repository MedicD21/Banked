{
  "name": "budget-mcp-server",
  "version": "1.0.0",
  "private": true,
  "description": "Personal budgeting MCP server with Plaid balance/transaction sync and reconciliation, deployed on Vercel.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "vercel dev",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file=.env --loader ts-node/esm scripts/migrate.ts",
    "db:seed": "node --env-file=.env --loader ts-node/esm scripts/seed.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@neondatabase/serverless": "^0.10.4",
    "plaid": "^33.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vercel/node": "^3.2.24",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
